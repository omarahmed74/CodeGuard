# Copy this file to .env and fill in your real key.
# .env is git-ignored — never commit real secrets.

# M2's vulnerability scan uses the Snyk CLI (proprietary vulnerability
# database, not open-source like Grype/NVD). Get your token from
# https://app.snyk.io -> Account Settings -> Auth Token, or run
# `snyk auth` once on this machine instead of setting this at all.
SNYK_TOKEN=your-snyk-api-token-here

# M3's existing AI enrichment integration uses Google's Gemini API
# (google-genai SDK), not Claude — see README "Note on the Claude vs
# Gemini discrepancy" for why.
GEMINI_API_KEY=your-gemini-api-key-here
